// Self-contained connector; fixed reads reused from our Community HTTP implementation.
&НаКлиенте
Перем ConnectionGeneration, RequestInFlight, ConnectionPort, AcceptedConnectionState;

&НаКлиенте
Процедура OnOpen(Отказ)
    Если BridgePort = 0 Тогда BridgePort = 9090; КонецЕсли;
    WaitTimeoutSeconds = 30;
    ConnectionGeneration = 0;
    RequestInFlight = Ложь;
    ConnectionState = "Не подключено";
КонецПроцедуры

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Процедура Connect(Команда)
#Иначе
&НаКлиенте
Процедура Connect(Команда)
#КонецЕсли
    Если RequestInFlight ИЛИ SessionToken <> "" Тогда Возврат; КонецЕсли;
    // The bound is derived from Go duration plus the existing 60-second result retention.
    Если WaitTimeoutSeconds <= 0 ИЛИ WaitTimeoutSeconds <> Цел(WaitTimeoutSeconds) ИЛИ WaitTimeoutSeconds > 9223371976 Тогда
        ConnectionState = "Укажите положительное целое число секунд, представимое длительностью сервера.";
        Возврат;
    КонецЕсли;
    ЗапрошеноОжидание = WaitTimeoutSeconds;
    ОшибкаПодключения = "Подключение отклонено. Код одноразовый, действует 5 минут. Проверьте порт; остановите прежний сеанс или перезапустите MCP-сервер и прочитайте новый код из файла выдачи.";
    RequestInFlight = Истина;
    Элементы.WaitTimeoutSeconds.Доступность = Ложь;
    Поколение = ConnectionGeneration;
    ПортПодключения = BridgePort;
    Попытка
        Идентичность = Identity();
        КонвертПодключения = PairEnvelope(Идентичность);
        Если ЗапрошеноОжидание <> 30 Тогда КонвертПодключения.Вставить("wait_timeout_seconds", ЗапрошеноОжидание); КонецЕсли;
#Если ВебКлиент Тогда
    Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
    Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        Если Ответ.КодСостояния = 400 И ЗапрошеноОжидание <> 30 Тогда
            ОшибкаПодключения = "Настройка ожидания требует совместимого MCP-сервера. Обновите сервер или выберите 30 секунд и подключитесь заново. Возможности подключения не изменены.";
            ВызватьИсключение "Wait timeout unsupported";
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("job_retry") Тогда
            КонвертПодключения.Удалить("job_retry");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("job_control") Тогда
            КонвертПодключения.Удалить("job_control");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("job_retry_read") Тогда
            КонвертПодключения.Удалить("job_retry_read");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("job_control_read") Тогда
            КонвертПодключения.Удалить("job_control_read");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("graph") Тогда
            КонвертПодключения.Удалить("graph");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("code_execute") Тогда
            КонвертПодключения.Удалить("code_execute");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("print_export") Тогда
            КонвертПодключения.Удалить("print_export");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("report_compose") Тогда
            КонвертПодключения.Удалить("report_compose");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("quality") Тогда
            КонвертПодключения.Удалить("quality");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("reconcile") Тогда
            КонвертПодключения.Удалить("reconcile");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("read_exchange_queue") Тогда
            КонвертПодключения.Удалить("read_exchange_queue");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        // A package-capable older bridge retains its supported marker.
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("incident_timeline") Тогда
            КонвертПодключения.Удалить("incident_timeline");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("job_diagnose") Тогда
            КонвертПодключения.Удалить("job_diagnose");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("object_diff") Тогда
            КонвертПодключения.Удалить("object_diff");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        // Older strict bridges accept the original envelope without the optional capability.
        Если Ответ.КодСостояния = 400 И КонвертПодключения.Свойство("query_package") Тогда
            КонвертПодключения.Удалить("query_package");
#Если ВебКлиент Тогда
            Ответ = Ждать CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#Иначе
            Ответ = CallBridge(ПортПодключения, "POST", "/pair", PairingToken, КонвертПодключения);
#КонецЕсли
        КонецЕсли;
        Если Ответ.КодСостояния <> 200 Тогда ВызватьИсключение "Pair refused"; КонецЕсли;
        Данные = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
        Если Данные.protocol <> 1 ИЛИ Данные.identity <> Идентичность Тогда ВызватьИсключение "Protocol refused"; КонецЕсли;
        ЕстьОжидание = Данные.Свойство("wait_timeout_seconds", ПодтвержденоОжидание);
        ЕстьПредел = Данные.Свойство("effective_default_wait_timeout_seconds", ДействуетОжидание);
        Подтверждено = ЕстьОжидание И ЕстьПредел;
        Если Подтверждено Тогда
            Подтверждено = ТипЗнч(ПодтвержденоОжидание) = Тип("Число") И ТипЗнч(ДействуетОжидание) = Тип("Число");
        КонецЕсли;
        Если Подтверждено Тогда Подтверждено = ПодтвержденоОжидание = ЗапрошеноОжидание И ДействуетОжидание > 0 И ДействуетОжидание <= ЗапрошеноОжидание; КонецЕсли;
        Если ЗапрошеноОжидание <> 30 И Не Подтверждено Тогда
            ОшибкаПодключения = "MCP-сервер не подтвердил настройку ожидания. Обновите сервер или выберите 30 секунд и подключитесь заново. При ошибке отключения перезапустите MCP-сервер и прочитайте новый код.";
#Если ВебКлиент Тогда
            Ждать CallBridge(ПортПодключения, "DELETE", "/session", Данные.session);
#Иначе
            CallBridge(ПортПодключения, "DELETE", "/session", Данные.session);
#КонецЕсли
            ВызватьИсключение "Wait timeout acknowledgement missing";
        КонецЕсли;
        СостояниеПодключения = "Подключено. Ожидание транспорта по умолчанию: " + Формат(ЗапрошеноОжидание, "ЧГ=0") + " сек. Отдельные операции могут иметь меньший срок.";
        Если Подтверждено И ДействуетОжидание < ЗапрошеноОжидание Тогда
            СостояниеПодключения = "Подключено. Ожидание транспорта по умолчанию ограничено сервером: " + Формат(ДействуетОжидание, "ЧГ=0") + " сек. Проверьте --request-timeout / MCP_1C_REQUEST_TIMEOUT. Отдельные операции имеют свои сроки.";
        КонецЕсли;
        Если Поколение = ConnectionGeneration Тогда
            ConnectionPort = ПортПодключения;
            NativeIdentity = Идентичность;
            SessionToken = Данные.session;
            PairingToken = "";
            AcceptedConnectionState = СостояниеПодключения;
            ConnectionState = AcceptedConnectionState;
            ПодключитьОбработчикОжидания("Poll", 1, Истина);
        Иначе
#Если ВебКлиент Тогда
    Ждать CallBridge(ПортПодключения, "DELETE", "/session", Данные.session);
#Иначе
    CallBridge(ПортПодключения, "DELETE", "/session", Данные.session);
#КонецЕсли
        КонецЕсли;
    Исключение
        Если Поколение = ConnectionGeneration Тогда
            ConnectionState = ОшибкаПодключения;
        КонецЕсли;
    КонецПопытки;
    RequestInFlight = Ложь;
    Элементы.WaitTimeoutSeconds.Доступность = SessionToken = "";
КонецПроцедуры

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Процедура Disconnect(Команда)
#Иначе
&НаКлиенте
Процедура Disconnect(Команда)
#КонецЕсли
#Если ВебКлиент Тогда
    Ждать StopConnection();
#Иначе
    StopConnection();
#КонецЕсли
КонецПроцедуры

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Функция StopConnection()
#Иначе
&НаКлиенте
Функция StopConnection()
#КонецЕсли
    ConnectionGeneration = ConnectionGeneration + 1;
    ОтключитьОбработчикОжидания("Poll");
    ИсходныйТокен = SessionToken;
    ИсходныйПорт = ConnectionPort;
    SessionToken = "";
    Элементы.WaitTimeoutSeconds.Доступность = Не RequestInFlight;
    NativeIdentity = "";
    ConnectionState = "Остановлено. Прочитайте новый код из файла выдачи; при ошибке перезапустите MCP-сервер. Уже начатая операция могла завершиться.";
    Если ИсходныйТокен <> "" Тогда
        Попытка
#Если ВебКлиент Тогда
    Ждать CallBridge(ИсходныйПорт, "DELETE", "/session", ИсходныйТокен);
#Иначе
    CallBridge(ИсходныйПорт, "DELETE", "/session", ИсходныйТокен);
#КонецЕсли
        Исключение
        КонецПопытки;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Процедура OnClose()
#Иначе
&НаКлиенте
Процедура OnClose()
#КонецЕсли
#Если ВебКлиент Тогда
    Ждать StopConnection();
#Иначе
    StopConnection();
#КонецЕсли
КонецПроцедуры

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Процедура Poll()
#Иначе
&НаКлиенте
Процедура Poll()
#КонецЕсли
    Если SessionToken = "" ИЛИ RequestInFlight Тогда Возврат; КонецЕсли;
    RequestInFlight = Истина;
    Поколение = ConnectionGeneration;
    ИсходныйТокен = SessionToken;
    ИсходныйПорт = ConnectionPort;
    ИсходнаяИдентичность = NativeIdentity;
    Попытка
        Если ИсходнаяИдентичность <> Identity() Тогда ВызватьИсключение "Native identity changed"; КонецЕсли;
#Если ВебКлиент Тогда
    Ответ = Ждать CallBridge(ИсходныйПорт, "POST", "/poll", ИсходныйТокен, Новый Структура("identity", ИсходнаяИдентичность));
#Иначе
    Ответ = CallBridge(ИсходныйПорт, "POST", "/poll", ИсходныйТокен, Новый Структура("identity", ИсходнаяИдентичность));
#КонецЕсли
        Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 204 Тогда ВызватьИсключение "Poll refused"; КонецЕсли;
        Если Ответ.КодСостояния = 200 И Поколение = ConnectionGeneration Тогда
            Задача = РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
            Результат = ExecuteTaskAtServer(Задача, ИсходнаяИдентичность, ИсходныйТокен);
            // Deliver started work with its original session, including after Stop.
#Если ВебКлиент Тогда
    Ответ = Ждать CallBridge(ИсходныйПорт, "POST", "/result/" + Задача.id, ИсходныйТокен, Результат);
#Иначе
    Ответ = CallBridge(ИсходныйПорт, "POST", "/result/" + Задача.id, ИсходныйТокен, Результат);
#КонецЕсли
            Если Ответ.КодСостояния <> 204 Тогда ВызватьИсключение "Result refused"; КонецЕсли;
        КонецЕсли;
        Если Поколение = ConnectionGeneration Тогда ConnectionState = AcceptedConnectionState; КонецЕсли;
    Исключение
        Если Поколение = ConnectionGeneration Тогда
            ConnectionState = "Связь прервана; повторный опрос. Для смены сеанса нажмите Остановить и Подключить.";
        КонецЕсли;
    КонецПопытки;
    RequestInFlight = Ложь;
    Элементы.WaitTimeoutSeconds.Доступность = SessionToken = "";
    Если SessionToken <> "" И Поколение = ConnectionGeneration Тогда ПодключитьОбработчикОжидания("Poll", 1, Истина); КонецЕсли;
КонецПроцедуры

&НаСервере
Функция Identity()
    Если ПривилегированныйРежим() Тогда ВызватьИсключение "Privileged execution refused"; КонецЕсли;
    Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Пользователь = Неопределено Тогда ВызватьИсключение "Native user unavailable"; КонецЕсли;
    // Bind the selected base without sending its connection string or filesystem path.
    Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
    Хеш.Добавить(СтрокаСоединенияИнформационнойБазы());
    Возврат Метаданные.Имя + ":" + Метаданные.Версия + ":" + Строка(Пользователь.УникальныйИдентификатор) + ":" + Base64Строка(Хеш.ХешСумма);
КонецФункции

&НаСервере
Функция HybridProof()
    Модуль = Метаданные.ОбщиеМодули.Найти("MCP_ProOperations");
    Если Модуль = Неопределено Тогда Возврат ""; КонецЕсли;
    Попытка
        Расширение = Модуль.РасширениеКонфигурации();
        Если Расширение = Неопределено ИЛИ Расширение.Имя <> "MCP_HTTPService" Тогда Возврат ""; КонецЕсли;
        // The optional installed module is resolved at runtime so pure EPF still opens.
        Возврат Вычислить("MCP_ProOperations.EPFИдентичность()");
    Исключение
        Возврат "";
    КонецПопытки;
КонецФункции

&НаСервере
Функция PairEnvelope(Идентичность)
    Конверт = Новый Структура("protocol,identity", 1, Идентичность);
    Ядро = HybridProof();
    Если Ядро <> "" Тогда
        Конверт.Вставить("core", Ядро);
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактПакета()");
            Если EPFМаркер = "query_package/1" Тогда Конверт.Вставить("query_package", EPFМаркер); КонецЕсли;
        Исключение
            // A document-only core keeps its original identity and FREE/document routes.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактСравнения()");
            Если EPFМаркер = "object_diff/1" Тогда Конверт.Вставить("object_diff", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores keep their supported reads without object comparison.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактДиагностикиЗадания()");
            Если EPFМаркер = "JOB-DIAG-1" Тогда Конверт.Вставить("job_diagnose", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores keep their supported reads without selected-job diagnosis.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактИнцидента()");
            Если EPFМаркер = "INCIDENT-TIMELINE-1" Тогда Конверт.Вставить("incident_timeline", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores keep their existing reads without incident context.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактОчереди()");
            Если EPFМаркер = "queue_observation/1" Тогда Конверт.Вставить("read_exchange_queue", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores retain their supported reads without queue capability.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактСверки()");
            Если EPFМаркер = "reconcile_read/1" Тогда Конверт.Вставить("reconcile", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores keep their supported reads without reconciliation.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактКачества()");
            Если EPFМаркер = "quality_read/1" Тогда Конверт.Вставить("quality", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores retain their supported reads without quality.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактОтчета()");
            Если EPFМаркер = "report_compose/1" Тогда Конверт.Вставить("report_compose", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores retain their supported reads without report composition.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактПечатиЭкспорта()");
            Если EPFМаркер = "print_export/1" Тогда Конверт.Вставить("print_export", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores retain their supported reads without print/export.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактКода()");
            Если EPFМаркер = "code_execute/1" Тогда Конверт.Вставить("code_execute", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores retain their supported reads without code execution.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактГрафа()");
            Если EPFМаркер = "graph_transfer/1" Тогда Конверт.Вставить("graph", EPFМаркер); КонецЕсли;
        Исключение
            // Older cores keep FREE and their previously supported operations.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактЧтенияЗадания()");
            Если EPFМаркер = "job_control_read/1" Тогда Конверт.Вставить("job_control_read", EPFМаркер); КонецЕсли;
        Исключение
            // An older core retains its other supported capabilities.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактЧтенияПовтора()");
            Если EPFМаркер = "job_retry_read/2" Тогда Конверт.Вставить("job_retry_read", EPFМаркер); КонецЕсли;
        Исключение
            // An older core retains its other supported capabilities.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактУправленияЗаданием()");
            Если EPFМаркер = "job_control/1" Тогда Конверт.Вставить("job_control", EPFМаркер); КонецЕсли;
        Исключение
            // An older core retains its existing reads without job mutations.
        КонецПопытки;
    КонецЕсли;
    Если Ядро <> "" Тогда
        Попытка
            EPFМаркер = Вычислить("MCP_ProOperations.EPFКонтрактПовтораЗадания()");
            Если EPFМаркер = "job_retry/2" Тогда Конверт.Вставить("job_retry", EPFМаркер); КонецЕсли;
        Исключение
            // An older core retains its existing reads without job mutations.
        КонецПопытки;
    КонецЕсли;
    Возврат Конверт;
КонецФункции

#Если ВебКлиент Тогда
&НаКлиенте
Асинх Функция CallBridge(Порт, Метод, Путь, Токен, Данные = Неопределено)
#Иначе
&НаКлиенте
Функция CallBridge(Порт, Метод, Путь, Токен, Данные = Неопределено)
#КонецЕсли
    Если Порт < 1 ИЛИ Порт > 65535 ИЛИ Порт <> Цел(Порт) Тогда ВызватьИсключение "Invalid port"; КонецЕсли;
    Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , Неопределено, 2);
    HTTPЗапрос = Новый HTTPЗапрос(Путь);
    HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
    Если Данные <> Неопределено Тогда
        HTTPЗапрос.УстановитьТелоИзСтроки(BridgeJSON(Данные), КодировкаТекста.UTF8);
    КонецЕсли;
#Если ВебКлиент Тогда
    Возврат Ждать Соединение.ВызватьHTTPМетодАсинх(Метод, HTTPЗапрос);
#Иначе
    Возврат Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
#КонецЕсли
КонецФункции

&НаСервере
Функция TaskDate(Текст)
    Возврат Дата(Число(Сред(Текст,1,4)),Число(Сред(Текст,6,2)),Число(Сред(Текст,9,2)),Число(Сред(Текст,12,2)),Число(Сред(Текст,15,2)),Число(Сред(Текст,18,2)));
КонецФункции

&НаСервере
Функция ExecuteTaskAtServer(Задача, ОжидаемаяИдентичность, ИсходныйТокен)
    Если ОжидаемаяИдентичность <> Identity() Тогда ВызватьИсключение "Native identity changed"; КонецЕсли;
    Результат = ОтветОшибка(408, "execution deadline expired; nothing dispatched");
    Если ТекущаяУниверсальнаяДата() < TaskDate(Задача.execute_before) Тогда
    Результат = ОтветОшибка(400, "unsupported EPF capability");
    ГрафЭтап = "";
    Попытка
        Если Задача.method = "POST" И ((Задача.path = "/execute" И Задача.capability = "advanced.code-execute") ИЛИ (Задача.path = "/query-package" И Задача.capability = "advanced.query-package") ИЛИ (Задача.path = "/object-diff" И Задача.capability = "advanced.object-diff") ИЛИ (Задача.path = "/job-diagnose" И Задача.capability = "advanced.job-diagnose") ИЛИ (Задача.path = "/incident-context" И Задача.capability = "pro.incident-context") ИЛИ (Задача.path = "/document-read" И Задача.capability = "pro.exchange-queue") ИЛИ (Задача.path = "/reconcile-read" И Задача.capability = "pro.reconcile-read") ИЛИ (Задача.path = "/job-control-cancel" И Задача.capability = "pro.job-control") ИЛИ ((Задача.path = "/job-retry-start" ИЛИ Задача.path = "/job-retry-cancel") И Задача.capability = "pro.job-retry") ИЛИ (Задача.path = "/job-control-read" И Задача.capability = "pro.job-control-read") ИЛИ ((Задача.path = "/job-retry-identity" ИЛИ Задача.path = "/job-retry-read") И Задача.capability = "pro.job-retry-read") ИЛИ (Задача.path = "/quality-read" И Задача.capability = "pro.quality-read") ИЛИ (Задача.path = "/report-compose" И Задача.capability = "pro.report-compose") ИЛИ (Задача.path = "/print-export" И Задача.capability = "pro.print-export")) Тогда
            Если Задача.session <> ИсходныйТокен ИЛИ Задача.core = "" ИЛИ Задача.core <> HybridProof() Тогда ВызватьИсключение "Hybrid binding refused"; КонецЕсли;
            ТекстЗапроса = Задача.body_text;
            Контекст = Новый Структура("task,session,core,deadline", Задача.id, Задача.session, Задача.core, Лев(Задача.execute_before, 19));
            Если Задача.capability = "pro.job-control" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFОтменаЗадания(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.job-retry" Тогда
                РежимПовтора = ?(Задача.path = "/job-retry-start", "start", "cancel");
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFИзменениеПовтора(ТекстЗапроса, РежимПовтора, Контекст)");
            ИначеЕсли Задача.capability = "pro.job-control-read" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFЧтениеЗадания(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.job-retry-read" Тогда
                РежимПовтора = ?(Задача.path = "/job-retry-identity", "identity", "read");
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFЧтениеПовтора(ТекстЗапроса, РежимПовтора, Контекст)");
            ИначеЕсли Задача.capability = "advanced.code-execute" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFКод(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.print-export" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFПечатьЭкспорт(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.report-compose" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFОтчет(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.quality-read" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFКачествоЧтение(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.reconcile-read" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFСверкаЧтение(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.capability = "pro.exchange-queue" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFОчередьЧтение(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.path = "/incident-context" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFКонтекстИнцидента(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.path = "/job-diagnose" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFДиагностикаЗадания(ТекстЗапроса, Контекст)");
            ИначеЕсли Задача.path = "/object-diff" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFСравнениеОбъектов(ТекстЗапроса, Контекст)");
            Иначе
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFПакетЗапроса(ТекстЗапроса, Контекст)");
            КонецЕсли;
            Результат = Новый Структура("status,body_text", 200, ТекстОтвета);
        ИначеЕсли Задача.method = "POST" И ((Задача.path = "/document-read" И (Задача.capability = "pro.document-read" ИЛИ Задача.capability = "pro.document-date" ИЛИ Задача.capability = "pro.document-receipt" ИЛИ Задача.capability = "pro.graph" ИЛИ Задача.capability = "pro.graph-receipt")) ИЛИ (Задача.path = "/document-commit" И (Задача.capability = "pro.document-date" ИЛИ Задача.capability = "pro.graph"))) Тогда
            Если Задача.path = "/document-read" И Задача.capability = "pro.graph" Тогда ГрафЭтап = "graph_binding"; КонецЕсли;
            Если Задача.session <> ИсходныйТокен ИЛИ Задача.core = "" ИЛИ Задача.core <> HybridProof() Тогда ВызватьИсключение "Hybrid binding refused"; КонецЕсли;
            ТекстЗапроса = BridgeJSON(Задача.body);
            Контекст = Новый Структура("task,session,core,deadline", Задача.id, Задача.session, Задача.core, Лев(Задача.execute_before, 19));
            // Fixed target and local variables only; no caller-provided BSL or method name.
            Если Задача.capability = "pro.graph" ИЛИ Задача.capability = "pro.graph-receipt" Тогда
                Если Задача.path = "/document-commit" Тогда
                    ТекстОтвета = Вычислить("MCP_ProOperations.EPFГрафЗапись(ТекстЗапроса, Контекст)");
                Иначе
                    ГрафЭтап = "graph_invocation";
                    ТекстОтвета = Вычислить("MCP_ProOperations.EPFГрафЧтение(ТекстЗапроса, Контекст)");
                    ГрафЭтап = "graph_response";
                КонецЕсли;
            ИначеЕсли Задача.path = "/document-commit" Тогда
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFДокументыЗапись(ТекстЗапроса, Контекст)");
            Иначе
                ТекстОтвета = Вычислить("MCP_ProOperations.EPFДокументыЧтение(ТекстЗапроса, Контекст)");
            КонецЕсли;
            Результат = ОтветJSON(РазобратьJSON(ТекстОтвета));
        ИначеЕсли Задача.method = "GET" И Задача.path = "/metadata" И Задача.capability = "community.metadata" Тогда
            Результат = МетаданныеGET(Неопределено);
        ИначеЕсли Задача.method = "GET" И Задача.path = "/configuration" И Задача.capability = "community.configuration" Тогда
            Результат = КонфигурацияGET(Неопределено);
        ИначеЕсли Задача.method = "GET" И Задача.path = "/version" И Задача.capability = "community.version" Тогда
            Результат = ОтветJSON(Новый Структура("connector_version,protocol", "0.1.0", 1));
        ИначеЕсли Задача.method = "POST" И Задача.path = "/query" И Задача.capability = "community.query" Тогда
            Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Задача.body);
            Результат = ЗапросPOST(Запись.Закрыть());
        ИначеЕсли Задача.method = "POST" И Задача.path = "/validate-query" И Задача.capability = "community.validate-query" Тогда
            Результат = ПроверкаЗапросаPOST(Задача.body);
        ИначеЕсли Задача.method = "POST" И Задача.path = "/count" И Задача.capability = "community.count" Тогда
            Результат = КоличествоPOST(Задача.body);
        ИначеЕсли Задача.method = "POST" И Задача.path = "/eventlog" И Задача.capability = "community.eventlog" Тогда
            Результат = ЖурналРегистрацииPOST(Задача.body);
        ИначеЕсли Задача.method = "GET" И Задача.capability = "community.storage" Тогда
            Результат = СтруктураХраненияGET(Задача.object_type, Задача.object_name);
        ИначеЕсли Задача.method = "GET" И Задача.path = "/subsystems" И Задача.capability = "community.subsystems" Тогда
            Результат = ПодсистемыGET();
        ИначеЕсли Задача.method = "GET" И Задача.capability = "community.object" Тогда
            Результат = ОбъектGET(Задача.object_type, Задача.object_name);
        ИначеЕсли Задача.method = "GET" И Задача.capability = "community.form" Тогда
            Результат = ФормаGET(Задача.object_type, Задача.object_name);
        КонецЕсли;
    Исключение
        Если Задача.capability = "community.object" ИЛИ Задача.capability = "community.subsystems" ИЛИ Задача.capability = "community.form" Тогда
            Результат = ОтветОшибка(503, "metadata source unavailable; check current user rights and platform support");
        ИначеЕсли Задача.capability = "community.validate-query" ИЛИ Задача.capability = "community.count" Тогда
            Результат = ОтветОшибка(503, "native parser/count source unavailable; check current user rights and platform support");
        ИначеЕсли Задача.capability = "community.storage" ИЛИ Задача.capability = "community.eventlog" Тогда
            Результат = ОтветОшибка(503, "native storage/event log source unavailable; verify current user permissions and platform support");
        Иначе
            Результат = ОтветОшибка(400, "native read refused; check current user rights");
            Если Задача.method = "POST" И Задача.path = "/document-read" И Задача.capability = "pro.graph" И ГрафЭтап <> "" Тогда Результат.body.Вставить("phase", ГрафЭтап); КонецЕсли;
        КонецЕсли;
    КонецПопытки;
    КонецЕсли;
    Результат.Вставить("identity", ОжидаемаяИдентичность);
    Возврат Результат;
КонецФункции

&НаСервере
Функция ОтветJSON(Данные)
    Возврат Новый Структура("status,body", 200, Данные);
КонецФункции

&НаСервере
Функция ОтветОшибка(Код, Текст)
    Возврат Новый Структура("status,body", Код, Новый Структура("error", Текст));
КонецФункции

&НаСервере
Функция BridgeJSON(Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервере
Функция РазобратьJSON(СтрокаJSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Результат;
КонецФункции

&НаСервере
Функция ПреобразоватьЗначениеПараметра(Знач Значение)
    // Значения query-параметров приходят из JSON строками. Если строка имеет ISO-формат
    // даты ("ГГГГ-ММ-ДД" или "ГГГГ-ММ-ДДTчч:мм:сс"), приводим её к типу Дата — иначе
    // виртуальные таблицы (.Остатки(&Дата, ...)) дают "Несоответствие типов (Параметр номер 1)".
    // Нестроковые значения и строки иного вида возвращаются без изменений; при неудаче
    // разбора возвращается исходная строка (безопасный откат к прежнему поведению).
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Значение;
    КонецЕсли;

    Длина = СтрДлина(Значение);
    РазделителиДаты = (Сред(Значение, 5, 1) = "-") И (Сред(Значение, 8, 1) = "-");
    ЭтоДата = (Длина = 10) И РазделителиДаты;
    ЭтоДатаВремя = (Длина >= 19) И РазделителиДаты
        И (Сред(Значение, 11, 1) = "T" ИЛИ Сред(Значение, 11, 1) = " ")
        И (Сред(Значение, 14, 1) = ":") И (Сред(Значение, 17, 1) = ":");

    Если НЕ (ЭтоДата ИЛИ ЭтоДатаВремя) Тогда
        Возврат Значение;
    КонецЕсли;

    Если ЭтоДата Тогда
        СтрокаДаты = Значение + "T00:00:00";
    Иначе
        СтрокаДаты = СтрЗаменить(Лев(Значение, 19), " ", "T");
    КонецЕсли;

    Попытка
        Возврат XMLЗначение(Тип("Дата"), СтрокаДаты);
    Исключение
        Возврат Значение;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ПривестиЗначениеКJSON(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

&НаСервере
Функция МетаданныеGET(Запрос)
    Результат = Новый Структура;

    ИменаКоллекций = Новый Массив;
    ИменаКоллекций.Добавить("Справочники");
    ИменаКоллекций.Добавить("Документы");
    ИменаКоллекций.Добавить("Перечисления");
    ИменаКоллекций.Добавить("Обработки");
    ИменаКоллекций.Добавить("Отчеты");
    ИменаКоллекций.Добавить("РегистрыСведений");
    ИменаКоллекций.Добавить("РегистрыНакопления");
    ИменаКоллекций.Добавить("РегистрыБухгалтерии");
    ИменаКоллекций.Добавить("РегистрыРасчета");
    ИменаКоллекций.Добавить("ПланыСчетов");
    ИменаКоллекций.Добавить("ПланыВидовХарактеристик");
    ИменаКоллекций.Добавить("ПланыВидовРасчета");
    ИменаКоллекций.Добавить("ПланыОбмена");
    ИменаКоллекций.Добавить("БизнесПроцессы");
    ИменаКоллекций.Добавить("Задачи");
    ИменаКоллекций.Добавить("ОпределяемыеТипы");
    ИменаКоллекций.Добавить("ЖурналыДокументов");
    ИменаКоллекций.Добавить("Константы");
    ИменаКоллекций.Добавить("ОбщиеМодули");
    ИменаКоллекций.Добавить("ОбщиеФормы");
    ИменаКоллекций.Добавить("ОбщиеКоманды");
    ИменаКоллекций.Добавить("ОбщиеМакеты");
    ИменаКоллекций.Добавить("Роли");
    ИменаКоллекций.Добавить("Подсистемы");
    ИменаКоллекций.Добавить("РегламентныеЗадания");
    ИменаКоллекций.Добавить("WebСервисы");
    ИменаКоллекций.Добавить("HTTPСервисы");

    // Коллекция, бросившая при обращении, пропускается, но её имя и текст ошибки
    // попадают в предупреждения: неполное дерево метаданных должно быть видно
    // потребителю, а не выглядеть полным ответом. То же поведение, что у
    // ПодсистемыGET (ключ warnings).
    Предупреждения = Новый Массив;

    Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
        Попытка
            Коллекция = Метаданные[ИмяКоллекции];
            Имена = Новый Массив;
            Для Каждого ОбъектМетаданных Из Коллекция Цикл
                Имена.Добавить(ОбъектМетаданных.Имя);
            КонецЦикла;
            Результат.Вставить(ИмяКоллекции, Имена);
        Исключение
            Предупреждения.Добавить(ИмяКоллекции + ": " + "native operation refused; check query syntax and native rights");
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Если Предупреждения.Количество() > 0 Тогда
        Результат.Вставить("warnings", Предупреждения);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

&НаСервере
Функция ЗапросPOST(ТекстВхода)
    // Тело здесь ОБЯЗАТЕЛЬНО: без query отвечать нечем. Всё, что не разбирается,
    // не является объектом или не содержит query, ОТКЛОНЯЕТСЯ конвертом
    // {"error":…}. Раньше такой запрос доходил до обращения к полю, платформа
    // поднимала исключение, и наружу уходил ответ 500 text/plain с именем
    // модуля и номером строки внутри него.
    ТелоЗапроса = ТекстВхода;

    ПараметрыЗапроса = Новый Структура;
    Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
        ОшибкаРазбора = "";
        Попытка
            ПараметрыЗапроса = РазобратьJSON(ТелоЗапроса);
        Исключение
            ОшибкаРазбора = "native operation refused; check query syntax and native rights";
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаРазбора) Тогда
            Возврат ОтветОшибка(400, "request body is not valid JSON: " + ОшибкаРазбора);
        КонецЕсли;
        Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
            Возврат ОтветОшибка(400, "request body must be a JSON object");
        КонецЕсли;
    КонецЕсли;

    ТекстЗапроса = "";
    Если ПараметрыЗапроса.Свойство("query") Тогда
        ТекстЗапроса = ПараметрыЗапроса.query;
    КонецЕсли;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required");
    КонецЕсли;

    // Лимит НЕ ЧИСЛОВОГО типа доходил до сравнения и рвал обработчик тем же
    // ответом 500, что и отсутствующее поле.
    Лимит = 100;
    Если ПараметрыЗапроса.Свойство("limit") И ЗначениеЗаполнено(ПараметрыЗапроса.limit) Тогда
        Если ТипЗнч(ПараметрыЗапроса.limit) <> Тип("Число") Тогда
            Возврат ОтветОшибка(400, "limit must be a number");
        КонецЕсли;
        Если ПараметрыЗапроса.limit > 0 Тогда
            Лимит = Мин(ПараметрыЗапроса.limit, 1000);
        КонецЕсли;
    КонецЕсли;

    Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, 10)));
    Если Лев(Префикс, 7) <> "ВЫБРАТЬ" И Лев(Префикс, 6) <> "SELECT" Тогда
        Возврат ОтветОшибка(400, "Only SELECT queries allowed");
    КонецЕсли;

    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);

        Если ПараметрыЗапроса.Свойство("parameters") И ТипЗнч(ПараметрыЗапроса.parameters) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из ПараметрыЗапроса.parameters Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;

        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        Возврат ОтветОшибка(400, "native operation refused; check query syntax and native rights");
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;

    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total", Счетчик);
    Результат.Вставить("truncated", Усечено);

    Возврат ОтветJSON(Результат);
КонецФункции

&НаСервере
Функция КонфигурацияGET(Запрос)
    Результат = Новый Структура;
    Результат.Вставить("name",             Метаданные.Имя);
    Результат.Вставить("version",          Метаданные.Версия);
    Результат.Вставить("vendor",           Метаданные.Поставщик);
    СИ = Новый СистемнаяИнформация;
    Результат.Вставить("platform_version", СИ.ВерсияПриложения);

    РежимИБ = "";
    Попытка
        СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
        Если СтрНайти(ВРег(СтрокаСоединения), "FILE=") > 0 Тогда
            РежимИБ = "file";
        ИначеЕсли СтрНайти(ВРег(СтрокаСоединения), "SRVR=") > 0 Тогда
            РежимИБ = "server";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Результат.Вставить("mode", РежимИБ);

    Возврат ОтветJSON(Результат);
КонецФункции


// Static metadata reads adapted from our Community HTTP helpers; no business form initialization.
&НаСервере
Функция НайтиМетаданныеПоТипуИИмени(МДТипОбъекта, МДИмяОбъекта)
    МДСоответствие = Новый Соответствие;
    МДСоответствие.Вставить("Catalog",                      Метаданные.Справочники);
    МДСоответствие.Вставить("Document",                     Метаданные.Документы);
    МДСоответствие.Вставить("Enum",                         Метаданные.Перечисления);
    МДСоответствие.Вставить("DataProcessor",                Метаданные.Обработки);
    МДСоответствие.Вставить("Report",                       Метаданные.Отчеты);
    МДСоответствие.Вставить("InformationRegister",          Метаданные.РегистрыСведений);
    МДСоответствие.Вставить("AccumulationRegister",         Метаданные.РегистрыНакопления);
    МДСоответствие.Вставить("AccountingRegister",           Метаданные.РегистрыБухгалтерии);
    МДСоответствие.Вставить("CalculationRegister",          Метаданные.РегистрыРасчета);
    МДСоответствие.Вставить("ChartOfAccounts",              Метаданные.ПланыСчетов);
    МДСоответствие.Вставить("ChartOfCharacteristicTypes",   Метаданные.ПланыВидовХарактеристик);
    МДСоответствие.Вставить("ChartOfCalculationTypes",      Метаданные.ПланыВидовРасчета);
    МДСоответствие.Вставить("ExchangePlan",                 Метаданные.ПланыОбмена);
    МДСоответствие.Вставить("BusinessProcess",              Метаданные.БизнесПроцессы);
    МДСоответствие.Вставить("Task",                         Метаданные.Задачи);
    МДСоответствие.Вставить("DefinedType",                  Метаданные.ОпределяемыеТипы);
    МДСоответствие.Вставить("Subsystem",                    Метаданные.Подсистемы);

    МДКоллекция = МДСоответствие[МДТипОбъекта];
    Если МДКоллекция = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если МДТипОбъекта = "Subsystem" Тогда
        Если СтрНайти(МДИмяОбъекта, ".") > 0 Тогда
            Возврат НайтиПодсистемуПоПолномуИмени(МДКоллекция, МДИмяОбъекта);
        КонецЕсли;
        МДСовпадения = Новый Массив;
        СобратьПодсистемыПоКороткомуИмени(МДКоллекция, МДИмяОбъекта, МДСовпадения);
        Если МДСовпадения.Количество() = 0 Тогда
            Возврат Неопределено;
        ИначеЕсли МДСовпадения.Количество() = 1 Тогда
            Возврат МДСовпадения[0];
        Иначе
            МДМаркер = Новый Структура;
            МДПолныеИмена = Новый Массив;
            Для Каждого МДНайденнаяПодсистема Из МДСовпадения Цикл
                Попытка
                    МДПолныеИмена.Добавить(МДНайденнаяПодсистема.ПолноеИмя());
                Исключение
                    МДПолныеИмена.Добавить(МДНайденнаяПодсистема.Имя);
                КонецПопытки;
            КонецЦикла;
            МДМаркер.Вставить("ambiguous", МДПолныеИмена);
            Возврат МДМаркер;
        КонецЕсли;
    КонецЕсли;

    Возврат МДКоллекция.Найти(МДИмяОбъекта);
КонецФункции

&НаСервере
Функция НайтиПодсистемуПоПолномуИмени(МДКоллекция, МДПолноеИмя)
    Для Каждого МДПодсистема Из МДКоллекция Цикл
        Если МДПодсистема.ПолноеИмя() = МДПолноеИмя Тогда Возврат МДПодсистема; КонецЕсли;
        МДВложенная = НайтиПодсистемуПоПолномуИмени(МДПодсистема.Подсистемы, МДПолноеИмя);
        Если МДВложенная <> Неопределено Тогда Возврат МДВложенная; КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

&НаСервере
Функция СобратьПодсистемыПоКороткомуИмени(МДКоллекция, МДИмя, МДСовпадения)
    Для Каждого МДПодсистема Из МДКоллекция Цикл
        Если МДПодсистема.Имя = МДИмя Тогда МДСовпадения.Добавить(МДПодсистема); КонецЕсли;
        СобратьПодсистемыПоКороткомуИмени(МДПодсистема.Подсистемы, МДИмя, МДСовпадения);
    КонецЦикла;
    Возврат МДСовпадения;
КонецФункции

&НаСервере
Функция ЕстьКоллекция(МДОбъектМД, МДИмяКоллекции)
    Попытка
        МДЗначение = МДОбъектМД[МДИмяКоллекции];
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ПолноеИмяИлиСтрокаТипа(МДТипЭлемента)
    МДМетаОбъект = Метаданные.НайтиПоТипу(МДТипЭлемента);
    Если МДМетаОбъект <> Неопределено Тогда
        Возврат МДМетаОбъект.ПолноеИмя();
    Иначе
        Возврат Строка(МДТипЭлемента);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ПредставлениеОписанияТипов(МДОписаниеТиповЗначения)
    МДЧасти = Новый Массив;
    Попытка
        Для Каждого МДТипЭлемента Из МДОписаниеТиповЗначения.Типы() Цикл
            МДЧасти.Добавить(ПолноеИмяИлиСтрокаТипа(МДТипЭлемента));
        КонецЦикла;
    Исключение
        МДЧасти = Новый Массив;
    КонецПопытки;

    Если МДЧасти.Количество() = 0 Тогда
        Возврат Строка(МДОписаниеТиповЗначения);
    КонецЕсли;
    Возврат СтрСоединить(МДЧасти, ", ");
КонецФункции

&НаСервере
Функция ПолучитьОсновнуюФорму(МДОбъектМД)
    МДМассивОсновных = Новый Массив;
    МДМассивОсновных.Добавить("ОсновнаяФормаОбъекта");
    МДМассивОсновных.Добавить("ОсновнаяФормаСписка");
    МДМассивОсновных.Добавить("ОсновнаяФормаВыбора");
    МДМассивОсновных.Добавить("ОсновнаяФорма");

    Для Каждого МДИмяСвойства Из МДМассивОсновных Цикл
        Попытка
            МДОсновнаяФорма = МДОбъектМД[МДИмяСвойства];
            Если МДОсновнаяФорма <> Неопределено Тогда
                Возврат МДОсновнаяФорма;
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Попытка
        Если МДОбъектМД.Формы.Количество() > 0 Тогда
            Для Каждого МДФормаМД Из МДОбъектМД.Формы Цикл
                Возврат МДФормаМД;
            КонецЦикла;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

&НаСервере
Функция ОбъектGET(МДТипОбъекта, МДИмяОбъекта)

    МДОбъектМД = НайтиМетаданныеПоТипуИИмени(МДТипОбъекта, МДИмяОбъекта);
    Если МДОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    Если МДТипОбъекта = "Subsystem" И ТипЗнч(МДОбъектМД) = Тип("Структура") Тогда
        Возврат ОтветJSON(МДОбъектМД);
    КонецЕсли;

    МДРезультат = Новый Структура;
    МДРезультат.Вставить("name", МДОбъектМД.Имя);
    МДРезультат.Вставить("synonym", МДОбъектМД.Синоним);

    МДРеквизиты = Новый Массив;
    Если ЕстьКоллекция(МДОбъектМД, "Реквизиты") Тогда
        Для Каждого МДРеквизит Из МДОбъектМД.Реквизиты Цикл
            МДОписаниеРеквизита = Новый Структура;
            МДОписаниеРеквизита.Вставить("name", МДРеквизит.Имя);
            МДОписаниеРеквизита.Вставить("synonym", МДРеквизит.Синоним);
            МДОписаниеРеквизита.Вставить("type", ПредставлениеОписанияТипов(МДРеквизит.Тип));
            МДРеквизиты.Добавить(МДОписаниеРеквизита);
        КонецЦикла;
    КонецЕсли;
    МДРезультат.Вставить("attributes", МДРеквизиты);

    Если ЕстьКоллекция(МДОбъектМД, "ТабличныеЧасти") Тогда
        МДТЧ = Новый Массив;
        Для Каждого МДТабличнаяЧасть Из МДОбъектМД.ТабличныеЧасти Цикл
            МДОписаниеТЧ = Новый Структура;
            МДОписаниеТЧ.Вставить("name", МДТабличнаяЧасть.Имя);
            МДРеквизитыТЧ = Новый Массив;
            Для Каждого МДРеквизит Из МДТабличнаяЧасть.Реквизиты Цикл
                МДОписание = Новый Структура;
                МДОписание.Вставить("name", МДРеквизит.Имя);
                МДОписание.Вставить("synonym", МДРеквизит.Синоним);
                МДОписание.Вставить("type", ПредставлениеОписанияТипов(МДРеквизит.Тип));
                МДРеквизитыТЧ.Добавить(МДОписание);
            КонецЦикла;
            МДОписаниеТЧ.Вставить("attributes", МДРеквизитыТЧ);
            МДТЧ.Добавить(МДОписаниеТЧ);
        КонецЦикла;
        МДРезультат.Вставить("tabularParts", МДТЧ);
    КонецЕсли;

    Если ЕстьКоллекция(МДОбъектМД, "Измерения") Тогда
        МДИзмерения = Новый Массив;
        Для Каждого МДИзмерение Из МДОбъектМД.Измерения Цикл
            МДОписание = Новый Структура;
            МДОписание.Вставить("name", МДИзмерение.Имя);
            МДОписание.Вставить("synonym", МДИзмерение.Синоним);
            МДОписание.Вставить("type", ПредставлениеОписанияТипов(МДИзмерение.Тип));
            МДИзмерения.Добавить(МДОписание);
        КонецЦикла;
        МДРезультат.Вставить("dimensions", МДИзмерения);
    КонецЕсли;

    Если ЕстьКоллекция(МДОбъектМД, "Ресурсы") Тогда
        МДРесурсы = Новый Массив;
        Для Каждого МДРесурс Из МДОбъектМД.Ресурсы Цикл
            МДОписание = Новый Структура;
            МДОписание.Вставить("name", МДРесурс.Имя);
            МДОписание.Вставить("synonym", МДРесурс.Синоним);
            МДОписание.Вставить("type", ПредставлениеОписанияТипов(МДРесурс.Тип));
            МДРесурсы.Добавить(МДОписание);
        КонецЦикла;
        МДРезультат.Вставить("resources", МДРесурсы);
    КонецЕсли;

    Если ЕстьКоллекция(МДОбъектМД, "ЗначенияПеречисления") Тогда
        МДЗначения = Новый Массив;
        Для Каждого МДЗначение Из МДОбъектМД.ЗначенияПеречисления Цикл
            МДОписание = Новый Структура;
            МДОписание.Вставить("name", МДЗначение.Имя);
            МДОписание.Вставить("synonym", МДЗначение.Синоним);
            МДОписание.Вставить("comment", МДЗначение.Комментарий);
            МДЗначения.Добавить(МДОписание);
        КонецЦикла;
        МДРезультат.Вставить("values", МДЗначения);
    КонецЕсли;

    Если МДТипОбъекта = "DefinedType" Тогда
        МДСоставТипов = Новый Массив;
        Попытка
            МДОписаниеТиповОбъекта = МДОбъектМД.Тип;
            Для Каждого МДТипЭлемента Из МДОписаниеТиповОбъекта.Типы() Цикл
                МДСоставТипов.Добавить(ПолноеИмяИлиСтрокаТипа(МДТипЭлемента));
            КонецЦикла;
        Исключение
            Попытка
                МДСоставТипов = Новый Массив;
                МДСоставТипов.Добавить(Строка(МДОбъектМД.Тип));
            Исключение
            КонецПопытки;
        КонецПопытки;
        МДРезультат.Вставить("types", МДСоставТипов);
    КонецЕсли;

    Если МДТипОбъекта = "Subsystem" Тогда
        МДПредупрежденияПодсистемы = Новый Массив;
        МДСостав = Новый Массив;
        Попытка
            Для Каждого МДЭлементСостава Из МДОбъектМД.Состав Цикл
                Попытка
                    МДСостав.Добавить(МДЭлементСостава.ПолноеИмя());
                Исключение
                    ДобавитьПредупреждениеПодсистемы(МДПредупрежденияПодсистемы, МДОбъектМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
                КонецПопытки;
            КонецЦикла;
        Исключение
            ДобавитьПредупреждениеПодсистемы(МДПредупрежденияПодсистемы, МДОбъектМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
        КонецПопытки;
        МДРезультат.Вставить("content", МДСостав);

        МДДочерниеПодсистемы = Новый Массив;
        Попытка
            Для Каждого МДДочерняяПодсистема Из МДОбъектМД.Подсистемы Цикл
                МДДочерниеПодсистемы.Добавить(ОписаниеПодсистемы(МДДочерняяПодсистема, МДПредупрежденияПодсистемы));
            КонецЦикла;
        Исключение
            ДобавитьПредупреждениеПодсистемы(МДПредупрежденияПодсистемы, МДОбъектМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
        КонецПопытки;
        МДРезультат.Вставить("subsystems", МДДочерниеПодсистемы);

        Если МДПредупрежденияПодсистемы.Количество() > 0 Тогда
            МДРезультат.Вставить("warnings", МДПредупрежденияПодсистемы);
        КонецЕсли;
    КонецЕсли;

    Возврат ОтветJSON(МДРезультат);
КонецФункции

&НаСервере
Процедура ДобавитьПредупреждениеПодсистемы(МДПредупреждения, МДПодсистемаМД, МДТекстОшибки)
    Если МДПредупреждения = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        МДПредупреждения.Добавить("Подсистема " + МДПодсистемаМД.Имя + ": " + МДТекстОшибки);
    Исключение
        Попытка
            МДПредупреждения.Добавить("Подсистема: " + МДТекстОшибки);
        Исключение
        КонецПопытки;
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ОписаниеПодсистемы(МДПодсистемаМД, МДПредупреждения)
    МДОписание = Новый Структура;
    МДОписание.Вставить("name", МДПодсистемаМД.Имя);
    Попытка
        МДОписание.Вставить("fullName", МДПодсистемаМД.ПолноеИмя());
    Исключение
        МДОписание.Вставить("fullName", "");
        ДобавитьПредупреждениеПодсистемы(МДПредупреждения, МДПодсистемаМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
    КонецПопытки;
    МДОписание.Вставить("synonym", МДПодсистемаМД.Синоним);

    МДСостав = Новый Массив;
    Попытка
        Для Каждого МДЭлементСостава Из МДПодсистемаМД.Состав Цикл
            Попытка
                МДСостав.Добавить(МДЭлементСостава.ПолноеИмя());
            Исключение
                ДобавитьПредупреждениеПодсистемы(МДПредупреждения, МДПодсистемаМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
            КонецПопытки;
        КонецЦикла;
    Исключение
        ДобавитьПредупреждениеПодсистемы(МДПредупреждения, МДПодсистемаМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
    КонецПопытки;
    МДОписание.Вставить("content", МДСостав);

    МДДочерниеПодсистемы = Новый Массив;
    Попытка
        Для Каждого МДДочерняяПодсистема Из МДПодсистемаМД.Подсистемы Цикл
            МДДочерниеПодсистемы.Добавить(ОписаниеПодсистемы(МДДочерняяПодсистема, МДПредупреждения));
        КонецЦикла;
    Исключение
        ДобавитьПредупреждениеПодсистемы(МДПредупреждения, МДПодсистемаМД, "Часть метаданных недоступна; проверьте права текущего пользователя и поддержку платформы");
    КонецПопытки;
    МДОписание.Вставить("subsystems", МДДочерниеПодсистемы);

    Возврат МДОписание;
КонецФункции

