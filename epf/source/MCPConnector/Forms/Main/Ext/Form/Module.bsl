&НаСервере
Функция ФормаGET(МДТипОбъекта, МДИмяОбъекта)
    МДОбъектМД = НайтиМетаданныеПоТипуИИмени(МДТипОбъекта, МДИмяОбъекта);
    Если МДОбъектМД = Неопределено Тогда Возврат ОтветОшибка(404, "Object not found"); КонецЕсли;
    Если ТипЗнч(МДОбъектМД) = Тип("Структура") Тогда Возврат ОтветОшибка(409, "Subsystem name is ambiguous; use its full metadata name"); КонецЕсли;
    МДФормаМД = ПолучитьОсновнуюФорму(МДОбъектМД);
    Если МДФормаМД = Неопределено Тогда Возврат ОтветОшибка(404, "Form not found; configure --dump for forms available only in the source export"); КонецЕсли;
    МДРезультат = Новый Структура("name,title,elements,commands,handlers", МДФормаМД.Имя, МДФормаМД.Синоним, Новый Массив, Новый Массив, Новый Массив);
    МДПредупреждения = Новый Массив;
    МДПредупреждения.Добавить("EPF прочитал только статические имя и заголовок формы. Элементы, команды и обработчики доступны из выгрузки конфигурации: запустите MCP-сервер с --dump.");
    МДРезультат.Вставить("warnings", МДПредупреждения);
    Возврат ОтветJSON(МДРезультат);
КонецФункции


// Fixed query parsing and permitted record count; no caller-supplied BSL or writes.
&НаСервере
Функция ПроверкаЗапросаPOST(ПРВход)
    Если ТипЗнч(ПРВход) <> Тип("Структура") Тогда Возврат ОтветОшибка(400, "query requires a typed JSON object"); КонецЕсли;
    Если ПРВход.Количество() <> 1 ИЛИ НЕ ПРВход.Свойство("query") Тогда Возврат ОтветОшибка(400, "query is required; unsupported fields are refused"); КонецЕсли;
    Если ТипЗнч(ПРВход.query) <> Тип("Строка") ИЛИ ПустаяСтрока(ПРВход.query) Тогда Возврат ОтветОшибка(400, "query must be a nonempty string"); КонецЕсли;
    ПРСхема = Новый СхемаЗапроса;
    Попытка
        ПРСхема.УстановитьТекстЗапроса(ПРВход.query);
        ПРСхема.ПолучитьТекстЗапроса();
        Возврат ОтветJSON(Новый Структура("valid,errors", Истина, Новый Массив));
    Исключение
        // Keep the parser diagnostic, not the outer BSL module/stack wrapper.
        ПРОшибка = ИнформацияОбОшибке();
        Пока ПРОшибка.Причина <> Неопределено Цикл ПРОшибка = ПРОшибка.Причина; КонецЦикла;
        ПРДиагностика = ПРОшибка.Описание;
        Если Лев(ПРДиагностика, 2) <> "{(" ИЛИ СтрНайти(ПРДиагностика, ")}") = 0 Тогда
            Возврат ОтветОшибка(503, "query parser source unavailable; check platform support and the current user");
        КонецЕсли;
        ПРОшибки = Новый Массив;
        ПРОшибки.Добавить(ПРДиагностика);
        Возврат ОтветJSON(Новый Структура("valid,errors", Ложь, ПРОшибки));
    КонецПопытки;
КонецФункции

&НаСервере
Функция КоличествоPOST(СЧВходКоличество)
    Если ПривилегированныйРежим() Тогда
        Возврат ОтветОшибка(403, "count is unavailable in a privileged context");
    КонецЕсли;
    СЧКодОтказа = 400;
    СЧПричинаОтказа = "count requires a typed JSON object with supported fields";
    Попытка
        СЧПараметры = СЧВходКоличество;
        ПроверитьПоляКоличество(СЧПараметры, "object_type,object_name,period,organization", "object_type,object_name");
        СЧПричинаОтказа = "count supports Catalog and Document metadata objects only";
        СЧТипОбъекта = Неопределено;
        СЧИмяОбъекта = Неопределено;
        СЧПараметры.Свойство("object_type", СЧТипОбъекта);
        СЧПараметры.Свойство("object_name", СЧИмяОбъекта);
        Если СЧТипОбъекта <> "Catalog" И СЧТипОбъекта <> "Document" Тогда
            ВызватьИсключение "count supports Catalog and Document only";
        КонецЕсли;
        ПроверитьИмяКоличество(СЧИмяОбъекта);
        СЧОбъектМД = НайтиМетаданныеПоТипуИИмени(СЧТипОбъекта, СЧИмяОбъекта);
        Если СЧОбъектМД = Неопределено Тогда
            Возврат ОтветОшибка(404, "selected count object not found");
        КонецЕсли;
        Если НЕ ПравоДоступа("Чтение", СЧОбъектМД) Тогда
            Возврат ОтветОшибка(403, "selected count table is denied");
        КонецЕсли;
        СЧТекст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + СЧОбъектМД.ПолноеИмя() + " КАК Данные ГДЕ ИСТИНА";
        СЧЗапросКоличество = Новый Запрос;
        СЧРезультат = Новый Структура("object_type,object_name", СЧТипОбъекта, СЧОбъектМД.Имя);
        Если СЧПараметры.Свойство("period") Тогда
            СЧПричинаОтказа = "period requires an admitted Date field and increasing exact civil dates YYYY-MM-DDTHH:MM:SS";
            СЧПериод = СЧПараметры.period;
            ПроверитьПоляКоличество(СЧПериод, "field,start,end", "field,start,end");
            ПроверитьИмяКоличество(СЧПериод.field);
            СЧПоле = СЧОбъектМД.Реквизиты.Найти(СЧПериод.field);
            Если СЧТипОбъекта = "Document" И СЧПериод.field = "Дата" Тогда
                СЧИмяПоля = "Дата";
            Иначе
                Если СЧПоле = Неопределено Тогда
                    ВызватьИсключение "period field is unavailable";
                КонецЕсли;
                Если НЕ СЧПоле.Тип.СодержитТип(Тип("Дата")) Тогда
                    ВызватьИсключение "period field must admit Date";
                КонецЕсли;
                СЧИмяПоля = СЧПоле.Имя;
            КонецЕсли;
            СЧНачало = ДатаКоличество(СЧПериод.start);
            СЧКонец = ДатаКоличество(СЧПериод.end);
            Если СЧНачало >= СЧКонец Тогда
                ВызватьИсключение "period start must precede end";
            КонецЕсли;
            СЧТекст = СЧТекст + " И Данные." + СЧИмяПоля + " >= &Начало И Данные." + СЧИмяПоля + " < &Конец";
            СЧЗапросКоличество.УстановитьПараметр("Начало", СЧНачало);
            СЧЗапросКоличество.УстановитьПараметр("Конец", СЧКонец);
            СЧРезультат.Вставить("period", СЧПериод);
        КонецЕсли;
        Если СЧПараметры.Свойство("organization") Тогда
            СЧПричинаОтказа = "organization requires an admitted field, Catalog type and nonempty UUID";
            СЧОрганизация = СЧПараметры.organization;
            ПроверитьПоляКоличество(СЧОрганизация, "field,reference", "field,reference");
            ПроверитьПоляКоличество(СЧОрганизация.reference, "catalog_name,uuid", "catalog_name,uuid");
            ПроверитьИмяКоличество(СЧОрганизация.field);
            ПроверитьИмяКоличество(СЧОрганизация.reference.catalog_name);
            СЧПоле = СЧОбъектМД.Реквизиты.Найти(СЧОрганизация.field);
            СЧКаталогМД = Метаданные.Справочники.Найти(СЧОрганизация.reference.catalog_name);
            Если СЧПоле = Неопределено ИЛИ СЧКаталогМД = Неопределено Тогда
                ВызватьИсключение "organization field or reference type is unavailable";
            КонецЕсли;
            Если НЕ СЧПоле.Тип.СодержитТип(Тип("СправочникСсылка." + СЧКаталогМД.Имя)) Тогда
                ВызватьИсключение "organization field does not admit selected Catalog reference";
            КонецЕсли;
            Если НЕ ПравоДоступа("Чтение", СЧКаталогМД) Тогда
                Возврат ОтветОшибка(403, "selected organization Catalog is denied");
            КонецЕсли;
            СЧПричинаОтказа = "organization reference is unavailable";
            СЧИдентификатор = UUIDКоличество(СЧОрганизация.reference.uuid);
            СЧСсылка = Справочники[СЧКаталогМД.Имя].ПолучитьСсылку(СЧИдентификатор);
            СЧПроверка = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ " + СЧКаталогМД.ПолноеИмя() + " ГДЕ Ссылка = &Ссылка");
            СЧПроверка.УстановитьПараметр("Ссылка", СЧСсылка);
            Если СЧПроверка.Выполнить().Пустой() Тогда
                Возврат ОтветОшибка(404, "organization reference not found or unavailable to the current user");
            КонецЕсли;
            СЧТекст = СЧТекст + " И Данные." + СЧПоле.Имя + " = &Организация";
            СЧЗапросКоличество.УстановитьПараметр("Организация", СЧСсылка);
            СЧРезультат.Вставить("organization", СЧОрганизация);
        КонецЕсли;
        СЧКодОтказа = 503;
        СЧПричинаОтказа = "count unavailable; verify current table, field and row read rights and platform support";
        СЧЗапросКоличество.Текст = СЧТекст;
        СЧВыборка = СЧЗапросКоличество.Выполнить().Выбрать();
        Если НЕ СЧВыборка.Следующий() Тогда
            ВызватьИсключение "count returned no result";
        КонецЕсли;
        СЧРезультат.Вставить("count", СЧВыборка.Количество);
        Возврат ОтветJSON(СЧРезультат);
    Исключение
        Возврат ОтветОшибка(СЧКодОтказа, СЧПричинаОтказа);
    КонецПопытки;
КонецФункции

&НаСервере
Процедура ПроверитьПоляКоличество(СЧЗначение, СЧРазрешенные, СЧОбязательные)
    Если ТипЗнч(СЧЗначение) <> Тип("Структура") Тогда
        ВызватьИсключение "count input must be an object";
    КонецЕсли;
    Для Каждого СЧЭлемент Из СЧЗначение Цикл
        Если СтрНайти("," + СЧРазрешенные + ",", "," + СЧЭлемент.Ключ + ",") = 0 Тогда
            ВызватьИсключение "unsupported count property";
        КонецЕсли;
    КонецЦикла;
    Для Каждого СЧИмя Из СтрРазделить(СЧОбязательные, ",") Цикл
        Если НЕ СЧЗначение.Свойство(СЧИмя) Тогда
            ВызватьИсключение "required count property is missing";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПроверитьИмяКоличество(СЧИмя)
    Если ТипЗнч(СЧИмя) <> Тип("Строка") ИЛИ ПустаяСтрока(СЧИмя) Тогда
        ВызватьИсключение "count requires metadata identifiers";
    КонецЕсли;
    Для СЧИндекс = 1 По СтрДлина(СЧИмя) Цикл
        СЧСимвол = Сред(СЧИмя, СЧИндекс, 1);
        Если СЧСимвол <> "_" И ВРег(СЧСимвол) = НРег(СЧСимвол) Тогда
            Если СЧИндекс = 1 ИЛИ СтрНайти("0123456789", СЧСимвол) = 0 Тогда
                ВызватьИсключение "invalid metadata identifier";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ДатаКоличество(СЧЗначение)
    Если ТипЗнч(СЧЗначение) <> Тип("Строка") ИЛИ СтрДлина(СЧЗначение) <> 19 Тогда
        ВызватьИсключение "exact civil timestamp required";
    КонецЕсли;
    Если Сред(СЧЗначение,5,1) <> "-" ИЛИ Сред(СЧЗначение,8,1) <> "-" ИЛИ Сред(СЧЗначение,11,1) <> "T"
        ИЛИ Сред(СЧЗначение,14,1) <> ":" ИЛИ Сред(СЧЗначение,17,1) <> ":" Тогда
        ВызватьИсключение "invalid civil timestamp";
    КонецЕсли;
    СЧЦифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(СЧЗначение,"-",""),"T",""),":","");
    Для СЧИндекс = 1 По СтрДлина(СЧЦифры) Цикл
        Если СтрНайти("0123456789", Сред(СЧЦифры,СЧИндекс,1)) = 0 Тогда
            ВызватьИсключение "invalid civil timestamp";
        КонецЕсли;
    КонецЦикла;
    СЧДата = XMLЗначение(Тип("Дата"), СЧЗначение);
    Если XMLСтрока(СЧДата) <> СЧЗначение Тогда
        ВызватьИсключение "invalid civil calendar date";
    КонецЕсли;
    Возврат СЧДата;
КонецФункции

&НаСервере
Функция UUIDКоличество(СЧЗначение)
    Если ТипЗнч(СЧЗначение) <> Тип("Строка") ИЛИ СтрДлина(СЧЗначение) <> 36 Тогда
        ВызватьИсключение "invalid Catalog reference UUID";
    КонецЕсли;
    СЧUUID = Новый УникальныйИдентификатор(СЧЗначение);
    Если НРег(Строка(СЧUUID)) <> НРег(СЧЗначение) ИЛИ СЧЗначение = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "empty or invalid Catalog reference UUID";
    КонецЕсли;
    Возврат СЧUUID;
КонецФункции


// Fixed native storage map and bounded Administration-only event log.
&НаСервере
Функция СтруктураХраненияGET(ХРТипОбъекта, ХРИмяОбъекта)

    ХРОбъектМД = НайтиМетаданныеПоТипуИИмени(ХРТипОбъекта, ХРИмяОбъекта);
    Если ХРОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    Если ТипЗнч(ХРОбъектМД) = Тип("Структура") Тогда
        Возврат ОтветОшибка(400, "Subsystem has no storage tables");
    КонецЕсли;

    ХРОбъектыМД = Новый Массив;
    ХРОбъектыМД.Добавить(ХРОбъектМД);

    ХРОшибкаПлатформы = Ложь;
    Попытка
        ХРСтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(ХРОбъектыМД, Истина);
    Исключение
        ХРОшибкаПлатформы = Истина;
    КонецПопытки;
    Если ХРОшибкаПлатформы Тогда
        Возврат ОтветОшибка(503, "native storage source unavailable; verify current user permissions and platform support");
    КонецЕсли;

    Если ХРСтруктураХранения.Количество() = 0 И ХРТипОбъекта <> "DataProcessor" И ХРТипОбъекта <> "Report" И ХРТипОбъекта <> "DefinedType" Тогда
        Возврат ОтветОшибка(503, "native platform returned no storage map for this stored object; this profile is not supported by the current source");
    КонецЕсли;
    ХРТаблицы = Новый Массив;
    Для Каждого ХРСтрокаТаблицы Из ХРСтруктураХранения Цикл
        ХРОписаниеТаблицы = Новый Структура;
        ХРОписаниеТаблицы.Вставить("storage_name", ХРСтрокаТаблицы.ИмяТаблицыХранения);
        ХРОписаниеТаблицы.Вставить("table_name",   ХРСтрокаТаблицы.ИмяТаблицы);
        ХРОписаниеТаблицы.Вставить("metadata",     ПолноеИмяМетаданных(ХРСтрокаТаблицы.Метаданные));
        ХРОписаниеТаблицы.Вставить("purpose",      ХРСтрокаТаблицы.Назначение);

        ХРПоля = Новый Массив;
        Для Каждого ХРСтрокаПоля Из ХРСтрокаТаблицы.Поля Цикл
            ХРПоля.Добавить(ОписаниеПоляХранения(ХРСтрокаПоля));
        КонецЦикла;
        ХРОписаниеТаблицы.Вставить("fields", ХРПоля);

        ХРИндексы = Новый Массив;
        Для Каждого ХРСтрокаИндекса Из ХРСтрокаТаблицы.Индексы Цикл
            ХРОписаниеИндекса = Новый Структура;
            ХРОписаниеИндекса.Вставить("name",         ЗначениеКолонкиЕслиЕсть(ХРСтрокаИндекса, "ИмяИндекса"));
            ХРОписаниеИндекса.Вставить("storage_name", ХРСтрокаИндекса.ИмяИндексаХранения);
            ХРПоляИндекса = Новый Массив;
            Для Каждого ХРПолеИндекса Из ХРСтрокаИндекса.Поля Цикл
                ХРПоляИндекса.Добавить(ОписаниеПоляХранения(ХРПолеИндекса));
            КонецЦикла;
            ХРОписаниеИндекса.Вставить("fields", ХРПоляИндекса);
            ХРИндексы.Добавить(ХРОписаниеИндекса);
        КонецЦикла;
        ХРОписаниеТаблицы.Вставить("indexes", ХРИндексы);

        ХРТаблицы.Добавить(ХРОписаниеТаблицы);
    КонецЦикла;

    ХРРезультат = Новый Структура;
    ХРРезультат.Вставить("name",      ХРОбъектМД.Имя);
    ХРРезультат.Вставить("full_name", ХРОбъектМД.ПолноеИмя());
    ХРРезультат.Вставить("tables",    ХРТаблицы);

    Возврат ОтветJSON(ХРРезультат);
КонецФункции

&НаСервере
Функция ОписаниеПоляХранения(ХРСтрокаПоля)
    ХРОписание = Новый Структура;
    ХРОписание.Вставить("name",         ХРСтрокаПоля.ИмяПоля);
    ХРОписание.Вставить("storage_name", ХРСтрокаПоля.ИмяПоляХранения);
    ХРОписание.Вставить("metadata",     ПолноеИмяМетаданных(ХРСтрокаПоля.Метаданные));
    Возврат ХРОписание;
КонецФункции

&НаСервере
Функция ПолноеИмяМетаданных(ХРЗначение)
    Если ХРЗначение = Неопределено ИЛИ ХРЗначение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(ХРЗначение) = Тип("ОбъектМетаданных") Тогда
        Возврат ХРЗначение.ПолноеИмя();
    Иначе
        Возврат Строка(ХРЗначение);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ЗначениеКолонкиЕслиЕсть(ХРСтрокаТаблицы, ХРИмяКолонки)
    Если ХРСтрокаТаблицы.Владелец().Колонки.Найти(ХРИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат ХРСтрокаТаблицы[ХРИмяКолонки];
КонецФункции

&НаСервере
Функция ЖурналРегистрацииPOST(ЖЛВходЖурнала)
    Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
        Возврат ОтветОшибка(403, "reading the event log requires the Администрирование right "
            + "and this account does not have it; no records are returned");
    КонецЕсли;

    ЖЛПараметры = ЖЛВходЖурнала;
    Если ТипЗнч(ЖЛПараметры) <> Тип("Структура") Тогда Возврат ОтветОшибка(400, "event log requires a typed JSON object"); КонецЕсли;
    Для Каждого ЖЛПолеВхода Из ЖЛПараметры Цикл
        Если СтрНайти(",start_date,end_date,level,event,user,limit,", "," + ЖЛПолеВхода.Ключ + ",") = 0 Тогда Возврат ОтветОшибка(400, "unsupported event log filter"); КонецЕсли;
        Если ЖЛПолеВхода.Ключ = "event" Тогда
            Если ТипЗнч(ЖЛПолеВхода.Значение) <> Тип("Массив") Тогда Возврат ОтветОшибка(400, "event must be an array of event names"); КонецЕсли;
        ИначеЕсли ЖЛПолеВхода.Ключ = "limit" Тогда
            Если ТипЗнч(ЖЛПолеВхода.Значение) <> Тип("Число") Тогда Возврат ОтветОшибка(400, "limit must be an integer"); КонецЕсли;
            Если ЖЛПолеВхода.Значение <> Цел(ЖЛПолеВхода.Значение) Тогда Возврат ОтветОшибка(400, "limit must be an integer"); КонецЕсли;
        Иначе
            Если ТипЗнч(ЖЛПолеВхода.Значение) <> Тип("Строка") Тогда Возврат ОтветОшибка(400, "event log dates, level and user must be strings"); КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    ЖЛОтбор = Новый Структура;


    Если ЖЛПараметры.Свойство("start_date") И ЗначениеЗаполнено(ЖЛПараметры.start_date) Тогда
        ЖЛДатаНачала = Неопределено;
        Попытка
            ЖЛДатаНачала = XMLЗначение(Тип("Дата"), ЖЛПараметры.start_date);
        Исключение
        КонецПопытки;
        Если ЖЛДатаНачала = Неопределено Тогда
            Возврат ОтветОшибка(400, "start_date is not an ISO 8601 date (e.g. 2026-03-01T00:00:00): "
                + Строка(ЖЛПараметры.start_date));
        КонецЕсли;
        ЖЛОтбор.Вставить("ДатаНачала", ЖЛДатаНачала);
    КонецЕсли;

    Если ЖЛПараметры.Свойство("end_date") И ЗначениеЗаполнено(ЖЛПараметры.end_date) Тогда
        ЖЛДатаОкончания = Неопределено;
        Попытка
            ЖЛДатаОкончания = XMLЗначение(Тип("Дата"), ЖЛПараметры.end_date);
        Исключение
        КонецПопытки;
        Если ЖЛДатаОкончания = Неопределено Тогда
            Возврат ОтветОшибка(400, "end_date is not an ISO 8601 date (e.g. 2026-03-07T23:59:59): "
                + Строка(ЖЛПараметры.end_date));
        КонецЕсли;
        ЖЛОтбор.Вставить("ДатаОкончания", ЖЛДатаОкончания);
    КонецЕсли;

    Если ЖЛПараметры.Свойство("level") И ЗначениеЗаполнено(ЖЛПараметры.level) Тогда
        ЖЛСоответствиеУровней = Новый Соответствие;
        ЖЛСоответствиеУровней.Вставить("Ошибка",        УровеньЖурналаРегистрации.Ошибка);
        ЖЛСоответствиеУровней.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
        ЖЛСоответствиеУровней.Вставить("Информация",     УровеньЖурналаРегистрации.Информация);
        ЖЛСоответствиеУровней.Вставить("Примечание",     УровеньЖурналаРегистрации.Примечание);
        ЖЛУровень = ЖЛСоответствиеУровней[ЖЛПараметры.level];
        Если ЖЛУровень = Неопределено Тогда
            Возврат ОтветОшибка(400, "unknown level: " + Строка(ЖЛПараметры.level)
                + " (allowed: Ошибка, Предупреждение, Информация, Примечание)");
        КонецЕсли;
        ЖЛМассивУровней = Новый Массив;
        ЖЛМассивУровней.Добавить(ЖЛУровень);
        ЖЛОтбор.Вставить("Уровень", ЖЛМассивУровней);
    КонецЕсли;

    Если ЖЛПараметры.Свойство("event") Тогда
        ЖЛЗапрошенныеСобытия = Новый Массив;
        Если ТипЗнч(ЖЛПараметры.event) = Тип("Строка") Тогда
            ЖЛЗапрошенныеСобытия.Добавить(ЖЛПараметры.event);
        ИначеЕсли ТипЗнч(ЖЛПараметры.event) = Тип("Массив") Тогда
            Для Каждого ЖЛЭлементОтбораСобытий Из ЖЛПараметры.event Цикл
                ЖЛЗапрошенныеСобытия.Добавить(ЖЛЭлементОтбораСобытий);
            КонецЦикла;
        Иначе
            Возврат ОтветОшибка(400, "event must be an event name or an array of event names");
        КонецЕсли;

        Если ЖЛЗапрошенныеСобытия.Количество() = 0 Тогда
            Возврат ОтветОшибка(400, "event is empty; leave it out to read the log without an "
                + "event filter");
        КонецЕсли;

        ЖЛЗначенияСобытий = Неопределено;
        ЖЛОшибкаСловаряСобытий = Ложь;
        Попытка
            ЖЛЗначенияСобытий = ПолучитьЗначенияОтбораЖурналаРегистрации("Событие").Событие;
        Исключение
            ЖЛОшибкаСловаряСобытий = Истина;
        КонецПопытки;
        Если ЖЛОшибкаСловаряСобытий Тогда
            Возврат ОтветОшибка(503, "event filter dictionary is unavailable; verify native platform support and current user permissions");
        КонецЕсли;
        Если ТипЗнч(ЖЛЗначенияСобытий) <> Тип("Соответствие") Тогда
            Возврат ОтветОшибка(503, "event filter cannot be resolved: the base did not answer "
                + "the event value list as a map, so no name in event can be checked against it");
        КонецЕсли;

        ЖЛМассивСобытийОтбора = Новый Массив;
        Для Каждого ЖЛИмяСобытия Из ЖЛЗапрошенныеСобытия Цикл
            Если ТипЗнч(ЖЛИмяСобытия) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ЖЛИмяСобытия) Тогда
                Возврат ОтветОшибка(400, "event must hold event names, and one of the values in "
                    + "it is not a name");
            КонецЕсли;
            Если ЖЛЗначенияСобытий.Получить(ЖЛИмяСобытия) = Неопределено Тогда
                Возврат ОтветОшибка(400, "unknown event: " + ЖЛИмяСобытия
                    + ". This base lists no event under that name. The name is a technical "
                    + "identifier such as _$Session$_.Start, not the phrase the 1С event log "
                    + "window shows; that phrase comes back in event_presentation");
            КонецЕсли;
            ЖЛМассивСобытийОтбора.Добавить(ЖЛИмяСобытия);
        КонецЦикла;
        ЖЛОтбор.Вставить("Событие", ЖЛМассивСобытийОтбора);
    КонецЕсли;

    Если ЖЛПараметры.Свойство("user") И ЗначениеЗаполнено(ЖЛПараметры.user) Тогда
        Если ТипЗнч(ЖЛПараметры.user) <> Тип("Строка") Тогда
            Возврат ОтветОшибка(400, "user must be a string");
        КонецЕсли;
        ЖЛПользовательИБ = Неопределено;
        ЖЛОшибкаПоиска = Ложь;
        Попытка
            ЖЛПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ЖЛПараметры.user);
        Исключение
            ЖЛОшибкаПоиска = Истина;
        КонецПопытки;
        Если ЖЛОшибкаПоиска Тогда
            Возврат ОтветОшибка(503, "user filter lookup is unavailable; verify native platform support and current user permissions");
        КонецЕсли;
        Если ЖЛПользовательИБ = Неопределено Тогда
            Возврат ОтветОшибка(400, "unknown infobase user: " + ЖЛПараметры.user);
        КонецЕсли;
        ЖЛМассивПользователей = Новый Массив;
        ЖЛМассивПользователей.Добавить(ЖЛПользовательИБ);
        ЖЛОтбор.Вставить("Пользователь", ЖЛМассивПользователей);
    КонецЕсли;

    ЖЛЛимит = 50;
    Если ЖЛПараметры.Свойство("limit") И ЗначениеЗаполнено(ЖЛПараметры.limit) Тогда
        Если ТипЗнч(ЖЛПараметры.limit) <> Тип("Число") Тогда
            Возврат ОтветОшибка(400, "limit must be a number");
        КонецЕсли;
        Если ЖЛПараметры.limit > 0 Тогда
            ЖЛЛимит = Мин(ЖЛПараметры.limit, 500);
        КонецЕсли;
    КонецЕсли;

    Если НЕ ЖЛОтбор.Свойство("ДатаНачала") Тогда
        ЖЛОтбор.Вставить("ДатаНачала", ТекущаяДата() - 7 * 86400);
    КонецЕсли;

    ЖЛТаблицаЖурнала = Новый ТаблицаЗначений;
    ВыгрузитьЖурналРегистрации(ЖЛТаблицаЖурнала, ЖЛОтбор, , , ЖЛЛимит);

    ЖЛМассивСобытий = Новый Массив;
    Для ЖЛИндекс = 0 По Мин(ЖЛЛимит, ЖЛТаблицаЖурнала.Количество()) - 1 Цикл
        ЖЛСтрока = ЖЛТаблицаЖурнала[ЖЛИндекс];
        ЖЛСобытие = Новый Структура;
        ЖЛСобытие.Вставить("date",        XMLСтрока(ЖЛСтрока.Дата));
        ЖЛСобытие.Вставить("level",       Строка(ЖЛСтрока.Уровень));
        ЖЛСобытие.Вставить("event",       Строка(ЖЛСтрока.Событие));
        ЖЛСобытие.Вставить("event_presentation", ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, "ПредставлениеСобытия"));
        ЖЛСобытие.Вставить("user",        Строка(ЖЛСтрока.ИмяПользователя));
        ЖЛСобытие.Вставить("computer",    Строка(ЖЛСтрока.Компьютер));
        ЖЛСобытие.Вставить("metadata",    ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, "ПредставлениеМетаданных"));
        ЖЛСобытие.Вставить("data",        ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, "ПредставлениеДанных"));
        ЖЛСобытие.Вставить("comment",     ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, "Комментарий"));
        ЖЛСобытие.Вставить("transaction", ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, "Транзакция"));
        ЖЛМассивСобытий.Добавить(ЖЛСобытие);
    КонецЦикла;

    ЖЛРезультат = Новый Структура;
    ЖЛРезультат.Вставить("events", ЖЛМассивСобытий);
    ЖЛРезультат.Вставить("total",  ЖЛМассивСобытий.Количество());

    Возврат ОтветJSON(ЖЛРезультат);
КонецФункции

&НаСервере
Функция ПолучитьКолонкуЖурнала(ЖЛСтрока, ЖЛТаблицаЖурнала, ЖЛИмяКолонки)
    Если ЖЛТаблицаЖурнала.Колонки.Найти(ЖЛИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(ЖЛСтрока[ЖЛИмяКолонки]);
КонецФункции
