// Обработчик GET /storage/{type}/{name}
// Возвращает таблицы, поля и индексы СУБД, в которых платформа хранит объект метаданных:
// ответ ПолучитьСтруктуруХраненияБазыДанных с именами базы данных (ИменаБазыДанных = Истина).
//
// URL параметры:
//   type — тип объекта, как у /object/{type}/{name}: Catalog, Document, InformationRegister,
//          AccumulationRegister, AccountingRegister, CalculationRegister, ChartOfAccounts,
//          ChartOfCharacteristicTypes, ChartOfCalculationTypes, ExchangePlan, BusinessProcess,
//          Task, Enum, DataProcessor, Report, DefinedType
//   name — имя объекта метаданных
//
// Ответ: JSON-объект с полями name, full_name, tables. Каждая таблица: storage_name (имя в СУБД),
// table_name (имя в языке запросов), metadata, purpose, fields (name, storage_name, metadata),
// indexes (name, storage_name, fields).
//
// Права: вызов выполняется в контексте текущего пользователя; доступ к структуре проверяет платформа.
// Ответ описывает метаданные хранения, не читает строки и не даёт права на чтение данных.
// Отказ платформы возвращается с её текстом в поле error.
//
// ПРИМЕЧАНИЕ: Вспомогательные функции НайтиМетаданныеПоТипуИИмени, ОтветJSON и ОтветОшибка
// определены в основном модуле HTTP-сервиса (Module.bsl). Там же лежит и то, что вызывают они
// сами: СформироватьJSON, НайтиПодсистемуПоПолномуИмени и СобратьПодсистемыПоКороткомуИмени.
// Функции ОписаниеПоляХранения, ПолноеИмяМетаданных и ЗначениеКолонкиЕслиЕсть приведены ниже вместе с обработчиком.

// GET /storage/{type}/{name}
// Таблицы и поля СУБД, в которых платформа хранит объект метаданных: ответ
// ПолучитьСтруктуруХраненияБазыДанных с именами базы данных (ИменаБазыДанных = Истина).
// Для вызова платформа требует право Администрирование; его отсутствие приходит
// исключением и уходит наружу конвертом {"error": ...} с текстом платформы,
// потому что ничего другого по нему вызывающая сторона сделать не может.
Функция СтруктураХраненияGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    // Маркер неоднозначности короткого имени подсистемы (см. ОбъектGET): у подсистемы
    // таблиц хранения нет, и уточнять имя здесь незачем.
    Если ТипЗнч(ОбъектМД) = Тип("Структура") Тогда
        Возврат ОтветОшибка(400, "Subsystem has no storage tables");
    КонецЕсли;

    ОбъектыМД = Новый Массив;
    ОбъектыМД.Добавить(ОбъектМД);

    ОшибкаПлатформы = "";
    Попытка
        СтруктураХранения = ПолучитьСтруктуруХраненияБазыДанных(ОбъектыМД, Истина);
    Исключение
        ОшибкаПлатформы = ОписаниеОшибки();
    КонецПопытки;
    Если ЗначениеЗаполнено(ОшибкаПлатформы) Тогда
        Возврат ОтветОшибка(500, "storage structure is not available: " + ОшибкаПлатформы);
    КонецЕсли;

    Таблицы = Новый Массив;
    Для Каждого СтрокаТаблицы Из СтруктураХранения Цикл
        ОписаниеТаблицы = Новый Структура;
        ОписаниеТаблицы.Вставить("storage_name", СтрокаТаблицы.ИмяТаблицыХранения);
        ОписаниеТаблицы.Вставить("table_name",   СтрокаТаблицы.ИмяТаблицы);
        ОписаниеТаблицы.Вставить("metadata",     ПолноеИмяМетаданных(СтрокаТаблицы.Метаданные));
        ОписаниеТаблицы.Вставить("purpose",      СтрокаТаблицы.Назначение);

        Поля = Новый Массив;
        Для Каждого СтрокаПоля Из СтрокаТаблицы.Поля Цикл
            Поля.Добавить(ОписаниеПоляХранения(СтрокаПоля));
        КонецЦикла;
        ОписаниеТаблицы.Вставить("fields", Поля);

        Индексы = Новый Массив;
        Для Каждого СтрокаИндекса Из СтрокаТаблицы.Индексы Цикл
            ОписаниеИндекса = Новый Структура;
            ОписаниеИндекса.Вставить("name",         ЗначениеКолонкиЕслиЕсть(СтрокаИндекса, "ИмяИндекса"));
            ОписаниеИндекса.Вставить("storage_name", СтрокаИндекса.ИмяИндексаХранения);
            ПоляИндекса = Новый Массив;
            Для Каждого ПолеИндекса Из СтрокаИндекса.Поля Цикл
                ПоляИндекса.Добавить(ОписаниеПоляХранения(ПолеИндекса));
            КонецЦикла;
            ОписаниеИндекса.Вставить("fields", ПоляИндекса);
            Индексы.Добавить(ОписаниеИндекса);
        КонецЦикла;
        ОписаниеТаблицы.Вставить("indexes", Индексы);

        Таблицы.Добавить(ОписаниеТаблицы);
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("name",      ОбъектМД.Имя);
    Результат.Вставить("full_name", ОбъектМД.ПолноеИмя());
    Результат.Вставить("tables",    Таблицы);

    Возврат ОтветJSON(Результат);
КонецФункции

// Одна строка колонки Поля из ПолучитьСтруктуруХраненияБазыДанных как структура для JSON.
Функция ОписаниеПоляХранения(СтрокаПоля)
    Описание = Новый Структура;
    Описание.Вставить("name",         СтрокаПоля.ИмяПоля);
    Описание.Вставить("storage_name", СтрокаПоля.ИмяПоляХранения);
    Описание.Вставить("metadata",     ПолноеИмяМетаданных(СтрокаПоля.Метаданные));
    Возврат Описание;
КонецФункции

// Колонка Метаданные у ПолучитьСтруктуруХраненияБазыДанных на одних платформах
// приходит строкой с полным именем, на других объектом метаданных; наружу всегда
// уходит полное имя. Пустое значение (служебное поле без метаданных) остаётся пустой строкой.
Функция ПолноеИмяМетаданных(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("ОбъектМетаданных") Тогда
        Возврат Значение.ПолноеИмя();
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

// Колонка ИмяИндекса у таблицы Индексы есть не на всех версиях платформы (на 8.3.27 её нет,
// индекс там описан только именем хранения и полями). Отсутствующая колонка это пустая строка.
// Остальные колонки читаются напрямую: их отсутствие было бы поломкой контракта платформы,
// и она должна дойти до вызывающей стороны исключением, а не пустым значением.
Функция ЗначениеКолонкиЕслиЕсть(СтрокаТаблицы, ИмяКолонки)
    Если СтрокаТаблицы.Владелец().Колонки.Найти(ИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат СтрокаТаблицы[ИмяКолонки];
КонецФункции
