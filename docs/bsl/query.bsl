// Обработчик POST /query
// Выполняет запрос на языке запросов 1С (только SELECT/ВЫБРАТЬ).
//
// Тело запроса: JSON {"query": "ВЫБРАТЬ ...", "limit": 100}
// Ответ: JSON {"columns": [...], "rows": [[...], ...], "total": N, "truncated": true/false}
//
// БЕЗОПАСНОСТЬ: Сервер-сторона дополнительно проверяет,
// что запрос начинается с ВЫБРАТЬ/SELECT.
//
// ОТКАЗЫ. Негодное тело отклоняется конвертом {"error": "..."}, а не доводится до
// обращения к полю: раньше такой вызов поднимал исключение платформы, и наружу
// уходил ответ 500 text/plain с именем модуля и номером строки внутри него.
//
// 400 {"error": "..."}  тело не разобралось как JSON либо это не объект;
//                       ключа query нет или его значение пусто;
//                       limit не число; запрос начинается не с ВЫБРАТЬ/SELECT;
//                       сам запрос не собрался или не выполнился.
//
// ПРИМЕЧАНИЕ: Вспомогательные функции РазобратьJSON, ОтветJSON, ОтветОшибка,
// ПреобразоватьЗначениеПараметра и ПривестиЗначениеКJSON определены в основном модуле
// HTTP-сервиса (Module.bsl). Там же лежит и то, что вызывают они сами: ОтветJSON и
// ОтветОшибка обращаются к СформироватьJSON.

Функция ЗапросPOST(Запрос)
    // Тело здесь ОБЯЗАТЕЛЬНО: без query отвечать нечем. Всё, что не разбирается,
    // не является объектом или не содержит query, ОТКЛОНЯЕТСЯ конвертом
    // {"error":…}. Раньше такой запрос доходил до обращения к полю, платформа
    // поднимала исключение, и наружу уходил ответ 500 text/plain с именем
    // модуля и номером строки внутри него.
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

    Параметры = Новый Структура;
    Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
        ОшибкаРазбора = "";
        Попытка
            Параметры = РазобратьJSON(ТелоЗапроса);
        Исключение
            ОшибкаРазбора = ОписаниеОшибки();
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаРазбора) Тогда
            Возврат ОтветОшибка(400, "request body is not valid JSON: " + ОшибкаРазбора);
        КонецЕсли;
        Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
            Возврат ОтветОшибка(400, "request body must be a JSON object");
        КонецЕсли;
    КонецЕсли;

    ТекстЗапроса = "";
    Если Параметры.Свойство("query") Тогда
        ТекстЗапроса = Параметры.query;
    КонецЕсли;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required");
    КонецЕсли;

    // Лимит НЕ ЧИСЛОВОГО типа доходил до сравнения и рвал обработчик тем же
    // ответом 500, что и отсутствующее поле.
    Лимит = 100;
    Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
        Если ТипЗнч(Параметры.limit) <> Тип("Число") Тогда
            Возврат ОтветОшибка(400, "limit must be a number");
        КонецЕсли;
        Если Параметры.limit > 0 Тогда
            Лимит = Мин(Параметры.limit, 1000);
        КонецЕсли;
    КонецЕсли;

    Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, 10)));
    Если Лев(Префикс, 7) <> "ВЫБРАТЬ" И Лев(Префикс, 6) <> "SELECT" Тогда
        Возврат ОтветОшибка(400, "Only SELECT queries allowed");
    КонецЕсли;

    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);

        Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из Параметры.parameters Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;

        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        Возврат ОтветОшибка(400, ОписаниеОшибки());
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;

    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total", Счетчик);
    Результат.Вставить("truncated", Усечено);

    Возврат ОтветJSON(Результат);
КонецФункции
