// Обработчик POST /count: Catalog/Document, разрешённые записи текущей сессии.
// Период [start,end): точные гражданские даты YYYY-MM-DDTHH:MM:SS без часового пояса.
// Организация: поле, имя справочника и UUID существующей доступной ссылки.
// Отказ в привилегированном контексте; права чтения и RLS не обходятся.
// ПРИМЕЧАНИЕ: РазобратьJSON, НайтиМетаданныеПоТипуИИмени, ОтветJSON и ОтветОшибка
// находятся в основном модуле HTTP-сервиса. Они используют СформироватьJSON,
// НайтиПодсистемуПоПолномуИмени и СобратьПодсистемыПоКороткомуИмени.
// Остальные вспомогательные процедуры и функции count приведены ниже.

// Fixed count does not share legacy query parameter conversion.
Функция КоличествоPOST(Запрос)
    Если ПривилегированныйРежим() Тогда
        Возврат ОтветОшибка(403, "count is unavailable in a privileged context");
    КонецЕсли;
    ПричинаОтказа = "count requires a typed JSON object with supported fields";
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
        ПроверитьПоляКоличество(Параметры, "object_type,object_name,period,organization", "object_type,object_name");
        ПричинаОтказа = "count supports Catalog and Document metadata objects only";
        ТипОбъекта = Неопределено;
        ИмяОбъекта = Неопределено;
        Параметры.Свойство("object_type", ТипОбъекта);
        Параметры.Свойство("object_name", ИмяОбъекта);
        Если ТипОбъекта <> "Catalog" И ТипОбъекта <> "Document" Тогда
            ВызватьИсключение "count supports Catalog and Document only";
        КонецЕсли;
        ПроверитьИмяКоличество(ИмяОбъекта);
        ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
        Если ОбъектМД = Неопределено Тогда
            ВызватьИсключение "selected count object is unavailable";
        КонецЕсли;
        Если НЕ ПравоДоступа("Чтение", ОбъектМД) Тогда
            Возврат ОтветОшибка(403, "selected count table is denied");
        КонецЕсли;
        Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + ОбъектМД.ПолноеИмя() + " КАК Данные ГДЕ ИСТИНА";
        ЗапросКоличество = Новый Запрос;
        Результат = Новый Структура("object_type,object_name", ТипОбъекта, ОбъектМД.Имя);
        Если Параметры.Свойство("period") Тогда
            ПричинаОтказа = "period requires an admitted Date field and increasing exact civil dates YYYY-MM-DDTHH:MM:SS";
            Период = Параметры.period;
            ПроверитьПоляКоличество(Период, "field,start,end", "field,start,end");
            ПроверитьИмяКоличество(Период.field);
            Поле = ОбъектМД.Реквизиты.Найти(Период.field);
            Если ТипОбъекта = "Document" И Период.field = "Дата" Тогда
                ИмяПоля = "Дата";
            Иначе
                Если Поле = Неопределено Тогда
                    ВызватьИсключение "period field is unavailable";
                КонецЕсли;
                Если НЕ Поле.Тип.СодержитТип(Тип("Дата")) Тогда
                    ВызватьИсключение "period field must admit Date";
                КонецЕсли;
                ИмяПоля = Поле.Имя;
            КонецЕсли;
            Начало = ДатаКоличество(Период.start);
            Конец = ДатаКоличество(Период.end);
            Если Начало >= Конец Тогда
                ВызватьИсключение "period start must precede end";
            КонецЕсли;
            Текст = Текст + " И Данные." + ИмяПоля + " >= &Начало И Данные." + ИмяПоля + " < &Конец";
            ЗапросКоличество.УстановитьПараметр("Начало", Начало);
            ЗапросКоличество.УстановитьПараметр("Конец", Конец);
            Результат.Вставить("period", Период);
        КонецЕсли;
        Если Параметры.Свойство("organization") Тогда
            ПричинаОтказа = "organization requires an admitted field, Catalog type and nonempty UUID";
            Организация = Параметры.organization;
            ПроверитьПоляКоличество(Организация, "field,reference", "field,reference");
            ПроверитьПоляКоличество(Организация.reference, "catalog_name,uuid", "catalog_name,uuid");
            ПроверитьИмяКоличество(Организация.field);
            ПроверитьИмяКоличество(Организация.reference.catalog_name);
            Поле = ОбъектМД.Реквизиты.Найти(Организация.field);
            КаталогМД = Метаданные.Справочники.Найти(Организация.reference.catalog_name);
            Если Поле = Неопределено ИЛИ КаталогМД = Неопределено Тогда
                ВызватьИсключение "organization field or reference type is unavailable";
            КонецЕсли;
            Если НЕ Поле.Тип.СодержитТип(Тип("СправочникСсылка." + КаталогМД.Имя)) Тогда
                ВызватьИсключение "organization field does not admit selected Catalog reference";
            КонецЕсли;
            Если НЕ ПравоДоступа("Чтение", КаталогМД) Тогда
                ВызватьИсключение "organization reference is unavailable";
            КонецЕсли;
            ПричинаОтказа = "organization reference is unavailable";
            Идентификатор = UUIDКоличество(Организация.reference.uuid);
            Ссылка = Справочники[КаталогМД.Имя].ПолучитьСсылку(Идентификатор);
            Проверка = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ " + КаталогМД.ПолноеИмя() + " ГДЕ Ссылка = &Ссылка");
            Проверка.УстановитьПараметр("Ссылка", Ссылка);
            Если Проверка.Выполнить().Пустой() Тогда
                ВызватьИсключение "organization reference is unavailable";
            КонецЕсли;
            Текст = Текст + " И Данные." + Поле.Имя + " = &Организация";
            ЗапросКоличество.УстановитьПараметр("Организация", Ссылка);
            Результат.Вставить("organization", Организация);
        КонецЕсли;
        ПричинаОтказа = "count failed: verify current table and row read rights";
        ЗапросКоличество.Текст = Текст;
        Выборка = ЗапросКоличество.Выполнить().Выбрать();
        Если НЕ Выборка.Следующий() Тогда
            ВызватьИсключение "count returned no result";
        КонецЕсли;
        Результат.Вставить("count", Выборка.Количество);
        Возврат ОтветJSON(Результат);
    Исключение
        // Count has no upstream diagnostic payload or identifier interpolation in errors.
        Возврат ОтветОшибка(400, ПричинаОтказа);
    КонецПопытки;
КонецФункции

Процедура ПроверитьПоляКоличество(Значение, Разрешенные, Обязательные)
    Если ТипЗнч(Значение) <> Тип("Структура") Тогда
        ВызватьИсключение "count input must be an object";
    КонецЕсли;
    Для Каждого Элемент Из Значение Цикл
        Если СтрНайти("," + Разрешенные + ",", "," + Элемент.Ключ + ",") = 0 Тогда
            ВызватьИсключение "unsupported count property";
        КонецЕсли;
    КонецЦикла;
    Для Каждого Имя Из СтрРазделить(Обязательные, ",") Цикл
        Если НЕ Значение.Свойство(Имя) Тогда
            ВызватьИсключение "required count property is missing";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьИмяКоличество(Имя)
    Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ ПустаяСтрока(Имя) Тогда
        ВызватьИсключение "count requires metadata identifiers";
    КонецЕсли;
    // The value is used only to resolve metadata; only metadata-owned names reach queries.
    Для Индекс = 1 По СтрДлина(Имя) Цикл
        Символ = Сред(Имя, Индекс, 1);
        Если Символ <> "_" И ВРег(Символ) = НРег(Символ) Тогда
            Если Индекс = 1 ИЛИ СтрНайти("0123456789", Символ) = 0 Тогда
                ВызватьИсключение "invalid metadata identifier";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ДатаКоличество(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ СтрДлина(Значение) <> 19 Тогда
        ВызватьИсключение "exact civil timestamp required";
    КонецЕсли;
    Если Сред(Значение,5,1) <> "-" ИЛИ Сред(Значение,8,1) <> "-" ИЛИ Сред(Значение,11,1) <> "T"
        ИЛИ Сред(Значение,14,1) <> ":" ИЛИ Сред(Значение,17,1) <> ":" Тогда
        ВызватьИсключение "invalid civil timestamp";
    КонецЕсли;
    Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение,"-",""),"T",""),":","");
    Для Индекс = 1 По СтрДлина(Цифры) Цикл
        Если СтрНайти("0123456789", Сред(Цифры,Индекс,1)) = 0 Тогда
            ВызватьИсключение "invalid civil timestamp";
        КонецЕсли;
    КонецЦикла;
    Дата = XMLЗначение(Тип("Дата"), Значение);
    Если XMLСтрока(Дата) <> Значение Тогда
        ВызватьИсключение "invalid civil calendar date";
    КонецЕсли;
    Возврат Дата;
КонецФункции

Функция UUIDКоличество(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ СтрДлина(Значение) <> 36 Тогда
        ВызватьИсключение "invalid Catalog reference UUID";
    КонецЕсли;
    UUID = Новый УникальныйИдентификатор(Значение);
    Если НРег(Строка(UUID)) <> НРег(Значение) ИЛИ Значение = "00000000-0000-0000-0000-000000000000" Тогда
        ВызватьИсключение "empty or invalid Catalog reference UUID";
    КонецЕсли;
    Возврат UUID;
КонецФункции
