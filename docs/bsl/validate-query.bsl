// Обработчик POST /validate-query
// Проверяет синтаксис запроса на языке запросов 1С без выполнения.
//
// Тело запроса: JSON {"query": "ВЫБРАТЬ ..."}
// Ответ: JSON {"valid": true/false, "errors": ["...", ...]}
//
// Использует СхемаЗапроса для разбора текста запроса.
// Если запрос корректен — valid=true, errors пустой.
// Если есть синтаксические ошибки — valid=false, errors содержит описания ошибок.
//
// ВАЖНО: СхемаЗапроса доступна начиная с платформы 8.3.5.
//
// ОТКАЗЫ. Негодное тело отклоняется конвертом {"error": "..."}, а не доводится до
// обращения к полю: раньше такой вызов поднимал исключение платформы, и наружу
// уходил ответ 500 text/plain с именем модуля и номером строки внутри него.
//
// 400 {"error": "..."}  тело не разобралось как JSON либо это не объект;
//                       ключа query нет или его значение пусто.
//
// Синтаксическая ошибка в самом запросе отказом НЕ является: это законный ответ 200
// с valid=false, ради которого инструмент и вызывают.
//
// ПРИМЕЧАНИЕ: Вспомогательные функции РазобратьJSON, ОтветJSON и ОтветОшибка определены
// в основном модуле HTTP-сервиса (Module.bsl). Там же лежит и то, что вызывают они сами:
// ОтветJSON и ОтветОшибка обращаются к СформироватьJSON.

Функция ПроверкаЗапросаPOST(Запрос)
    // Отказ «query is required» тут был, но срабатывал ПОЗЖЕ обращения к полю,
    // поэтому ловил только пустую строку. Тело без ключа query до него не
    // доживало: обращение к отсутствующему полю поднимало исключение, и ответом
    // был всё тот же 500 text/plain с именем модуля и номером строки.
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

    Параметры = Новый Структура;
    Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
        ОшибкаРазбора = "";
        Попытка
            Параметры = РазобратьJSON(ТелоЗапроса);
        Исключение
            ОшибкаРазбора = ОписаниеОшибки();
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаРазбора) Тогда
            Возврат ОтветОшибка(400, "request body is not valid JSON: " + ОшибкаРазбора);
        КонецЕсли;
        Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
            Возврат ОтветОшибка(400, "request body must be a JSON object");
        КонецЕсли;
    КонецЕсли;

    ТекстЗапроса = "";
    Если Параметры.Свойство("query") Тогда
        ТекстЗапроса = Параметры.query;
    КонецЕсли;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required");
    КонецЕсли;

    Ошибки = Новый Массив;

    Попытка
        СхемаЗапроса = Новый СхемаЗапроса;
        СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
        СхемаЗапроса.ПолучитьТекстЗапроса();

        Результат = Новый Структура;
        Результат.Вставить("valid", Истина);
        Результат.Вставить("errors", Ошибки);
    Исключение
        Результат = Новый Структура;
        Результат.Вставить("valid", Ложь);
        Ошибки.Добавить(ОписаниеОшибки());
        Результат.Вставить("errors", Ошибки);
    КонецПопытки;

    Возврат ОтветJSON(Результат);
КонецФункции
